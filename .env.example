# ============================================================
# VARIÁVEIS OBRIGATÓRIAS NA VERCEL
# ============================================================

# URL do banco PostgreSQL (obrigatório)
# Use o MESMO banco do portal-app para que as carteirinhas apareçam no APK
# Exemplo com Neon: postgres://usuario:senha@host.neon.tech/banco?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/painel_puc"

# Credenciais de acesso ao painel admin (obrigatório em produção)
ADMIN_EMAIL="admin@pucminas.br"
ADMIN_PASSWORD="admin123"

# Chave longa e aleatória usada para assinar o cookie da sessão administrativa.
# Gere uma diferente da senha do painel (por exemplo: openssl rand -hex 32).
ADMIN_SESSION_SECRET="troque-por-uma-chave-aleatoria-longa"

# URL pública do painel admin na Vercel
# Exemplo: https://painel-puc.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================================
# VARIÁVEIS OBRIGATÓRIAS PARA UPLOAD DE IMAGENS
# ============================================================
# Na Vercel o filesystem é READ-ONLY, então uploads locais NÃO funcionam.
# É obrigatório configurar o Cloudinary para produção.

# Cloudinary (obrigatório na Vercel)
CLOUDINARY_CLOUD_NAME="seu-cloud-name"
CLOUDINARY_API_KEY="seu-api-key"
CLOUDINARY_API_SECRET="seu-api-secret"
CLOUDINARY_FOLDER="puc-minas/cards"

# ============================================================
# VARIÁVEIS OPCIONAIS
# ============================================================

# URL pública do portal (APK/PWA) na Vercel
# Usado para gerar links corretos nas carteirinhas
# Exemplo: https://portalpuc-app.vercel.app
NEXT_PUBLIC_PORTAL_URL=""

# Path customizado para a página pública da carteirinha no portal
# Deixe vazio para usar o padrão /card/{id}
NEXT_PUBLIC_PORTAL_CARD_PATH=""

# Path customizado para a página de login do aluno no portal
# Deixe vazio para usar o padrão /aluno/login
NEXT_PUBLIC_PORTAL_LOGIN_PATH=""
