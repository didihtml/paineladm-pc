generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Card {
  id             String    @id
  nome           String
  codigo         String?
  cpf            String
  atribuicao     String?
  rg             String?
  campus         String?
  nascimento     DateTime?
  curso          String
  codigoAcesso   String?
  instituicao    String
  validade       DateTime
  fotoUrl        String
  status         String
  createdAt      DateTime  @default(now())
  alunoSenhaHash String
  alunoUsuario   String    @unique
  origem         String    @default("SGA")

  @@map("cards")
}
